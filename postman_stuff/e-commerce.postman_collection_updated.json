  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "packages": {},
        "requests": {},
        "exec": [
          "// const getTokenRequest = {\r",
          "//   url: `${pm.environment.get(\"url\")}/realms/${pm.environment.get(\"realm\")}/protocol/openid-connect/token`,\r",
          "//   method: 'POST',\r",
          "//   header: 'Content-Type: application/x-www-form-urlencoded',\r",
          "//   body: {\r",
          "//     mode: 'urlencoded',\r",
          "//     urlencoded: [\r",
          "//         {key: 'grant_type', value: 'password'},\r",
          "//         {key: 'client_id', value: pm.environment.get(\"client_id\")},\r",
          "//         {key: 'client_secret', value: pm.environment.get(\"client_secret\")},\r",
          "//         {key: 'username', value: pm.environment.get(\"username\")},\r",
          "//         {key: 'password', value: pm.environment.get(\"password\")}\r",
          "//     ]\r",
          "//   }\r",
          "// };\r",
          "\r",
          "// pm.sendRequest(getTokenRequest, (err, response) => {\r",
          "//     // In case of Keycloak complaint.\r",
          "//     console.log(\"Keycloak Response Body:\", response.text());\r",
          "    \r",
          "//     if (response.code === 200) {\r",
          "//         pm.collectionVariables.set(\"current_access_token\", response.json().access_token);\r",
          "//     } else {\r",
          "//         console.error(\"Login Failed! Status:\", response.code);\r",
          "//     }\r",
          "// });\r",
          "const tokenExpiry = pm.collectionVariables.get(\"token_expiry\");\r",
          "const currentTime = Date.now();\r",
          "\r",
          "// 1. Check if we have a token AND if it's still valid \r",
          "// (Subtract 10 seconds as a \"buffer\" for network lag)\r",
          "if (pm.collectionVariables.get(\"current_access_token\") && tokenExpiry && currentTime < (tokenExpiry - 10000)) {\r",
          "    console.log(\"Token is still fresh. Skipping Keycloak login.\");\r",
          "} else {\r",
          "    console.log(\"Token expired or missing. Fetching new token...\");\r",
          "\r",
          "    const getTokenRequest = {\r",
          "        url: `${pm.environment.get(\"url\")}/realms/${pm.environment.get(\"realm\")}/protocol/openid-connect/token`,\r",
          "        method: 'POST',\r",
          "        header: { 'Content-Type': 'application/x-www-form-urlencoded' },\r",
          "        body: {\r",
          "            mode: 'urlencoded',\r",
          "            urlencoded: [\r",
          "                { key: 'grant_type', value: 'password' },\r",
          "                { key: 'client_id', value: pm.environment.get(\"client_id\") },\r",
          "                { key: 'client_secret', value: pm.environment.get(\"client_secret\") },\r",
          "                { key: 'username', value: pm.environment.get(\"username\") },\r",
          "                { key: 'password', value: pm.environment.get(\"password\") }\r",
          "            ]\r",
          "        }\r",
          "    };\r",
          "\r",
          "    pm.sendRequest(getTokenRequest, (err, response) => {\r",
          "        if (err) {\r",
          "            console.error(\"Network error:\", err);\r",
          "        } else if (response.code === 200) {\r",
          "            const jsonResponse = response.json();\r",
          "            \r",
          "            // Save the token\r",
          "            pm.collectionVariables.set(\"current_access_token\", jsonResponse.access_token);\r",
          "            \r",
          "            // Calculate and save the absolute expiration timestamp (ususally 60 -300 seconds)\r",
          "            const expiryDate = Date.now() + (jsonResponse.expires_in * 1000);\r",
          "            pm.collectionVariables.set(\"token_expiry\", expiryDate);\r",
          "            \r",
          "            console.log(\"New token secured. Valid for \" + jsonResponse.expires_in + \" seconds.\");\r",
          "        } else {\r",
          "            console.error(\"Keycloak rejected login! Status:\", response.code, response.text());\r",
          "        }\r",
          "    });\r",
          "}"
        ]
      }
